---
import ThemeToggle from './ThemeToggle.astro';
// hideCta: oculta "Ingresar" + "Empezar con Practicante" (la landing del libro no
// los quiere — su único CTA es comprar). El resto de las páginas los conserva.
const { hideCta = false } = Astro.props;
---
<nav>
  <a href="/" class="logo">
    <img src="/assets/endonautas-logo.png" alt="Endonautas" width="28" height="28" style="object-fit:contain">
    <span class="logo-n">Endonautas</span>
  </a>
  <div class="nav-links">
    <a href="/">El libro</a>
    <a href="/para-terapeutas/">Para terapeutas</a>
    <a href="/blog/">Blog</a>
    <a href="/contacto/">Contacto</a>
  </div>
  <div class="nav-r">
    <slot />
    <ThemeToggle />
    {!hideCta && (
      <>
        <a href="https://app.endonautas.cl/login/" class="btn btn-o btn-sm nav-cta">Ingresar</a>
        <a href="https://app.endonautas.cl/registro/?plan=practicante" class="btn btn-p btn-sm nav-cta">Empezar con Practicante</a>
      </>
    )}
    <button class="hamburger" id="hamburger" aria-label="Menú" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <a href="/">El libro</a>
  <a href="/para-terapeutas/">Para terapeutas</a>
  <a href="/blog/">Blog</a>
  <a href="/contacto/">Contacto</a>
  {!hideCta && (
    <div class="mobile-menu-ctas">
      <a href="https://app.endonautas.cl/login/" class="btn btn-o btn-sm">Ingresar</a>
      <a href="https://app.endonautas.cl/registro/?plan=practicante" class="btn btn-p btn-sm">Empezar con Practicante</a>
    </div>
  )}
</div>

<script is:inline>
(function(){
  var ham = document.getElementById('hamburger');
  var menu = document.getElementById('mobile-menu');
  if (!ham || !menu) return;
  ham.addEventListener('click', function(){
    var open = ham.getAttribute('aria-expanded') === 'true';
    ham.setAttribute('aria-expanded', String(!open));
    ham.classList.toggle('open');
    menu.classList.toggle('open');
    menu.setAttribute('aria-hidden', String(open));
    document.body.style.overflow = open ? '' : 'hidden';
  });
  menu.querySelectorAll('a').forEach(function(a){
    a.addEventListener('click', function(){
      ham.setAttribute('aria-expanded', 'false');
      ham.classList.remove('open');
      menu.classList.remove('open');
      menu.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    });
  });
})();
</script>

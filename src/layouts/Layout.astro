---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description = 'Endonautas — plataforma para terapeutas y coaches: agenda, fichas clínicas, tests validados que se corrigen solos y clientes que trabajan entre sesiones.',
  ogImage = '/og/default.jpg',
  ogType = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- tema: dark por defecto, sin flash -->
  <script is:inline>
    try {
      var t = localStorage.getItem('endo-theme') || 'dark';
      document.documentElement.setAttribute('data-theme', t);
    } catch (e) { document.documentElement.setAttribute('data-theme', 'dark'); }
  </script>

  <!-- OG / Twitter -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Endonautas" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />
  <meta name="twitter:site" content="@endonautas" />

  <link rel="icon" type="image/png" href="/assets/endonautas-logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Schema.org -->
  <script type="application/ld+json" is:inline>{JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://endonautas.cl/#org",
        "name": "Endonautas",
        "url": "https://endonautas.cl",
        "logo": "https://endonautas.cl/assets/endonautas-logo.png",
        "founder": { "@type": "Person", "name": "Franco Jeria Castro" },
        "sameAs": []
      },
      {
        "@type": "WebSite",
        "@id": "https://endonautas.cl/#website",
        "url": "https://endonautas.cl",
        "name": "Endonautas",
        "publisher": { "@id": "https://endonautas.cl/#org" }
      }
    ]
  })}</script>

  <!-- Umami analytics -->
  <script defer data-website-id="e03fa69e-9931-411c-9838-7f6ffea90426" src="https://analytics.146.181.39.4.sslip.io/script.js" is:inline></script>

  <slot name="head" />
</head>
<body>

<div id="lp-wrap">
  <Nav>
    <slot name="nav" />
  </Nav>
  <slot />
  <Footer />
</div>

<!-- Reveals + FAQ + theme toggle -->
<script is:inline>
(function(){
  const obs = new IntersectionObserver(entries=>{
    entries.forEach(e=>{
      if(!e.isIntersecting) return;
      e.target.classList.add('on');
      obs.unobserve(e.target);
    });
  }, {threshold:.1, rootMargin:'0px 0px -30px 0px'});
  document.querySelectorAll('.from-l,.from-r,.from-b').forEach(el=>{
    if(!el.closest('#inicio') && !el.closest('#hero')) obs.observe(el);
  });

  document.querySelectorAll('.faq-item').forEach(item=>{
    item.querySelector('.faq-q')?.addEventListener('click',()=>{
      const open=item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i=>i.classList.remove('open'));
      if(!open) item.classList.add('open');
    });
  });

  document.querySelectorAll('[data-theme-toggle]').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('endo-theme', next); } catch (e) {}
    });
  });
})();
</script>

</body>
</html>

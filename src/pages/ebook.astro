---
// Landing standalone del ebook — NO usa <Layout> ni global.css a propósito.
// Decisión de Franco (2026-08-19): el ebook tiene comprador y nicho propios (quien
// hizo el test de heridas), distinto del SaaS B2B del resto del sitio — no hereda su
// identidad visual (cosmos oscuro, calipso, Space Grotesk). Paleta y tipografía
// nuevas, elegidas tras investigar 4 referencias reales del nicho (Thais Gibson /
// Personal Development School, Dr. Nicole LePera, innerchild.coach, Constelando el
// Origen) — las cuatro usan fondo claro/cálido, nunca oscuro. Retoma la paleta de
// marca "Ojos cerrados, acento oro" diseñada en mayo 2026 y nunca implementada.
import { HERIDAS } from '../data/heridas';

const HERIDAS_MIN = HERIDAS.map(({ id, herida, mascara, frase, intro }) => ({
  id, herida, mascara, frase, intro: intro[0],
}));

// ponytail: testimonios de personas REALES que pasaron por la mentoría (Marcos —
// estrés laboral, Lilian — pareja y maternidad, Annette — pareja, Francisca —
// pareja, Ramón — duelo, Ani, Alejandra). Las frases textuales se perdieron con el
// celular anterior y hay que volver a pedírselas.
//
// NO se publica nada inventado en su nombre: mientras el array esté vacío la
// sección entera no se renderiza. Para encenderla, pegar aquí las frases tal como
// las escriban (con su permiso para usarlas) — con 3 ya aparece.
const TESTIMONIOS: { texto: string; autor: string }[] = [];

const title = 'Endonautica — el libro | Endonautas';
// Descripción para tráfico frío, igual que el hero estático: quien la ve en Google
// o al compartirse el link todavía no hizo el test de heridas.
const description = 'El mapa que nadie te dio para navegar tu mundo interior. Endonautica, de Franco Jeria Castro: viaje interior, herida de infancia, sombra y niveles de conciencia. 207 páginas, $17 USD, entrega inmediata.';
const canonical = 'https://endonautas.cl/ebook/';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://endonautas.cl/assets/img/epic-ebook.png" />
  <meta property="og:type" content="book" />
  <link rel="icon" type="image/png" href="/assets/endonautas-logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400;1,500&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script defer data-website-id="e03fa69e-9931-411c-9838-7f6ffea90426" src="https://analytics.146.181.39.4.sslip.io/script.js" is:inline></script>
</head>
<body>

  <nav>
    <a href="/" class="nv-logo">Endonautas</a>
    <a href="/" class="nv-back">← Inicio</a>
  </nav>

  <!-- ── HERO ── -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="price-badge">$17 USD · ≈ $16.990 CLP · EPUB · entrega inmediata</p>
        {/* El copy ESTÁTICO es el de tráfico frío: quien llega de un reel no hizo
            ningún test. El script de abajo lo reescribe cuando viene `?herida=`,
            así que la versión personalizada sigue intacta — y Google indexa esta. */}
        <p class="kicker" id="hk">El libro</p>
        <h1 id="h1">El mapa que nadie te dio<br/><em>para navegar tu mundo interior.</em></h1>
        <p class="lead" id="hero-sub">
          No es otro libro de autoayuda. Soy Franco, terapeuta en salud integrativa,
          y escribí <em>Endonautica</em> como un sistema de navegación para quien ya
          sabe que hay algo más profundo y está listo para encontrarlo — no para
          saber más sobre ti, sino para dejar de repetir lo que ya reconociste.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-p" href="#comprar" id="cta-hero">Comprarlo ahora — $17</a>
          <a class="btn btn-o" href="#muestra">Leer un fragmento primero</a>
        </div>
      </div>
      <div class="hero-cover">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
        <img src="/assets/img/epic-ebook.png" alt="Portada de Endonautica" loading="eager">
      </div>
    </div>
  </section>

  <!-- ── EL PROBLEMA ── -->
  <section class="sec">
    <div class="wrap wrap-narrow">
      <p class="eyebrow">El problema</p>
      <h2 class="sec-h">Sabes que hay un patrón. Pero no puedes verlo desde adentro.</h2>
      <p class="body">
        La mayoría de las personas lleva décadas repitiendo los mismos ciclos: las
        mismas relaciones, los mismos bloqueos, los mismos resultados distintos.
      </p>
      <p class="body">
        No porque sean incapaces de cambiar. Sino porque nunca tuvieron el lenguaje
        para nombrar lo que está pasando en su interior.
      </p>
      <p class="body">
        Sin lenguaje no hay observación. Sin observación no hay conciencia.
        <em>Sin conciencia, el patrón manda.</em>
      </p>
      <p class="body">La endonáutica es ese lenguaje.</p>
    </div>
  </section>

  <!-- ── QUÉ ES LA ENDONÁUTICA ── -->
  <section class="sec sec-alt">
    <div class="wrap wrap-narrow">
      <p class="eyebrow">Qué es la endonáutica</p>
      <h2 class="sec-h">Una ciencia del viaje interior. No una promesa de bienestar.</h2>
      <p class="body">
        <em>Endo</em> — del griego: dentro. <em>Náutica</em> — del griego: lo relativo
        a las naves y los viajes. <em>Endonáutica: el arte de navegar el mundo interior.</em>
      </p>
      <p class="body">
        No es meditación. No es coaching. No es terapia. Es un sistema de comprensión
        que integra psicología, filosofía, espiritualidad y lógica fractal para que
        puedas observar tu mundo interior con la misma precisión con que un navegante
        lee el mar.
      </p>
      <p class="body">
        Cuando tu perspectiva de la realidad cambia, tu realidad cambia.
        La endonáutica te da la perspectiva.
      </p>
    </div>
  </section>

  <!-- ── QUÉ ES EXACTAMENTE ── -->
  <section class="sec">
    <div class="wrap wrap-narrow">
      <h2 class="sec-h">Qué es exactamente</h2>
      <p class="body">
        No te escribí un PDF de 40 páginas ni un manual clínico. Son 207 páginas:
        mi marco completo de la endonáutica — viaje interior, arquetipos, la
        sombra, niveles de conciencia — con la herida de infancia como una de sus
        piezas centrales, no la única.
      </p>
      <p class="body">
        Si llegaste desde el test, la sección de heridas te va a hablar directo:
        es el mismo marco, desarrollado en profundidad. El resto del libro es el
        terreno donde esa herida vive — identidad, inconsciente, cuerpo,
        propósito. No te prometo resolverte en una lectura. Es un mapa, no un
        atajo.
      </p>
    </div>
  </section>

  <!-- ── QUÉ ENCONTRARÁS DENTRO (índice) ── -->
  <section class="sec sec-alt">
    <div class="wrap wrap-narrow">
      <p class="eyebrow">El contenido</p>
      <h2 class="sec-h">207 páginas de cartografía interior</h2>
      <ol class="toc">
        <li>
          <span class="toc-n">01</span>
          <div>
            <p class="toc-h">La Endonáutica</p>
            <p class="toc-t">Qué es el mundo interior, el viaje del héroe, los arquetipos, la sombra, la ley del espejo, el propósito.</p>
          </div>
        </li>
        <li>
          <span class="toc-n">02</span>
          <div>
            <p class="toc-h">El Endonauta</p>
            <p class="toc-t">Qué es la conciencia y sus niveles, la energía, el observador, el Espejo Humeante, tu función.</p>
          </div>
        </li>
        <li>
          <span class="toc-n">03</span>
          <div>
            <p class="toc-h">Pilares</p>
            <p class="toc-t">Autoconciencia, autoestima, autorregulación, locus de control, autocuidado, autosabotaje, autoconocimiento, interdependencia.</p>
          </div>
        </li>
        <li>
          <span class="toc-n">04</span>
          <div>
            <p class="toc-h">Psicología</p>
            <p class="toc-t">El yo, la personalidad, el inconsciente, los sueños, la herida de infancia, la dualidad.</p>
          </div>
        </li>
        <li>
          <span class="toc-n">05</span>
          <div>
            <p class="toc-h">Filosofía</p>
            <p class="toc-t">Unidad, dualidad, fractales, filosofía del implícito, leyes espirituales del endonauta.</p>
          </div>
        </li>
      </ol>
      <p class="m-foot">
        No es información nueva para decorar tu cabeza. Es un sistema para que veas
        distinto lo que ya vives.
      </p>
    </div>
  </section>

  <!-- ── MUESTRA DEL FRAMEWORK ── -->
  <section class="sec" id="muestra">
    <div class="wrap wrap-narrow">
      <p class="eyebrow">Un fragmento real</p>
      <h2 class="sec-h" id="m-title">La herida de abandono, en el libro</h2>
      <div class="quote-card">
        <p class="m-text" id="m-text"></p>
      </div>
      <p class="m-foot">
        Esto es un fragmento de una sola herida. El libro completo tiene esta y
        las otras cuatro, desarrolladas igual de a fondo — más todo lo demás.
      </p>
    </div>
  </section>

  {/* Se renderiza sola cuando haya al menos 3 frases reales en TESTIMONIOS. */}
  {TESTIMONIOS.length >= 3 && (
    <section class="sec">
      <div class="wrap wrap-narrow">
        <p class="eyebrow">Quienes ya lo caminaron</p>
        <h2 class="sec-h">Lo que pasó cuando pusieron nombre al patrón</h2>
        <div class="tst-grid">
          {TESTIMONIOS.map((t) => (
            <figure class="tst">
              <p class="tst-q">“{t.texto}”</p>
              <figcaption class="tst-a">{t.autor}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── PARA QUIÉN ES / PARA QUIÉN NO ── -->
  <section class="sec sec-alt">
    <div class="wrap wrap-narrow">
      <p class="eyebrow">Antes de comprarlo</p>
      <h2 class="sec-h">Para quién es — y para quién no</h2>
      <div class="fit-grid">
        <div class="fit-col">
          <p class="fit-h fit-yes">Para quién es</p>
          <ul class="fit-list">
            <li>Para quien siente que hay un patrón detrás de sus errores y quiere nombrarlo.</li>
            <li>Para quien ya intentó otras cosas y siente que le falta el mapa, no la herramienta.</li>
            <li>Para quien está dispuesto a mirarse sin filtros.</li>
            <li>Para quien entiende que el cambio real es lento, profundo y no es lineal.</li>
          </ul>
        </div>
        <div class="fit-col">
          <p class="fit-h fit-no">Para quién no</p>
          <ul class="fit-list fit-list-no">
            <li>Para quien busca motivación rápida y frases bonitas.</li>
            <li>Para quien quiere que alguien más haga el trabajo interior por él.</li>
            <li>Para quien espera resultados en 7 días.</li>
            <li>Para quien prefiere esperar a que algo externo cambie.</li>
          </ul>
        </div>
      </div>
      <p class="m-foot">Si llegaste hasta aquí, probablemente eres de los primeros.</p>
    </div>
  </section>

  <!-- ── AUTOR ── -->
  <section class="sec">
    <div class="wrap autor-grid">
      <img class="autor-foto" src="/assets/img/franco-jeria.jpeg" alt="Franco Jeria Castro">
      <div>
        <p class="eyebrow">Quién te escribe esto</p>
        <h2 class="sec-h">Franco Jeria Castro</h2>
        <p class="body">
          Terapeuta en salud integrativa. Escribí <em>Endonautica</em> después de
          años acompañando procesos de autoconocimiento — es el mapa que yo
          hubiera querido tener antes, ordenado para que no tengas que empezar
          de cero.
        </p>
      </div>
    </div>
  </section>

  <!-- ── PRECIO + CHECKOUT ── -->
  <section class="sec sec-alt" id="comprar">
    <div class="wrap wrap-narrow">
      <div class="buy-card">
        <p class="eyebrow" style="text-align:center">Endonautica — ebook completo</p>
        <p class="buy-price">$17 <span>USD</span></p>
        {/* El cobro real en Chile es CLP: `PRODUCTS['endonautica-ebook'].price_clp`
            en el repo de la app (payments/constants.py). Si cambia allá, cambia acá. */}
        <p class="buy-clp">Desde Chile se cobran <strong>$16.990 CLP</strong></p>
        <p class="buy-sub">EPUB · 207 páginas · llega a tu email apenas se confirma el pago</p>

        <div class="buy-forms">
          <form method="POST" action="https://app.endonautas.cl/pago/ebook/comprar/mp/" class="buy-form">
            <input type="hidden" name="canal_origen" value="ebook-landing">
            <p class="buy-gw">Desde Chile</p>
            <label class="buy-label" for="mp-email">Tu email</label>
            <input id="mp-email" type="email" name="email" class="buy-input" placeholder="tu@correo.com" required autocomplete="email">
            <button type="submit" class="btn btn-p buy-btn">Pagar con MercadoPago</button>
          </form>

          <form method="POST" action="https://app.endonautas.cl/pago/ebook/comprar/paypal/" class="buy-form">
            <input type="hidden" name="canal_origen" value="ebook-landing">
            <p class="buy-gw">Desde otro país</p>
            <label class="buy-label" for="pp-email">Tu email</label>
            <input id="pp-email" type="email" name="email" class="buy-input" placeholder="tu@correo.com" required autocomplete="email">
            <button type="submit" class="btn btn-o buy-btn">Pagar con PayPal</button>
          </form>
        </div>

        <p class="buy-wa">
          ¿Prefieres transferencia o tienes una duda antes de pagar?
          <a href="https://wa.me/56938713033?text=Hola%20Franco%2C%20tengo%20una%20duda%20sobre%20el%20ebook%20Endonautica" target="_blank" rel="noopener">Escríbeme por WhatsApp</a>.
        </p>
      </div>

      <div class="warranty">
        <p class="warranty-h">Garantía de 7 días</p>
        <p class="warranty-t">
          Si en 7 días sientes que no te aportó nada, te devuelvo el dinero.
          <em>Sin preguntas.</em> Confío en el mapa porque lo caminé yo primero.
        </p>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="sec" id="faq">
    <div class="wrap wrap-narrow">
      <h2 class="sec-h">Preguntas frecuentes</h2>
      <div class="faq-item">
        <button type="button" class="faq-q">¿En qué formato llega?</button>
        <div class="faq-a"><p>EPUB — se lee en Apple Books, Google Play Books, la app de Kindle, o cualquier lector de ebooks. No es un PDF escaneado.</p></div>
      </div>
      <div class="faq-item">
        <button type="button" class="faq-q">¿Cuándo lo recibo?</button>
        <div class="faq-a"><p>Apenas se confirma el pago, a tu email, con el link de descarga. Si no te llega en unos minutos, revisa spam o escríbeme por WhatsApp.</p></div>
      </div>
      <div class="faq-item">
        <button type="button" class="faq-q">¿Esto reemplaza terapia o un proceso guiado?</button>
        <div class="faq-a"><p>No. Es un mapa para leer y trabajar por tu cuenta. Si algo de lo que aparece te remueve más de lo esperado, eso es material para trabajar acompañado, no en soledad.</p></div>
      </div>
      <div class="faq-item">
        <button type="button" class="faq-q">¿Hay garantía?</button>
        <div class="faq-a"><p>Sí: 7 días sin preguntas. Si sientes que el libro no te aportó nada, escríbeme dentro de los 7 días de la compra y te devuelvo los $17 completos. No tienes que justificar nada.</p></div>
      </div>
      <div class="faq-item">
        <button type="button" class="faq-q">¿Es para principiantes?</button>
        <div class="faq-a"><p>Sí y no. Si nunca exploraste el mundo interior, este libro es tu primer mapa. Si ya tienes camino recorrido, vas a encontrar capas nuevas. No necesitas saber de psicología ni de filosofía: el sistema está explicado desde cero, con lenguaje propio.</p></div>
      </div>
      <div class="faq-item">
        <button type="button" class="faq-q">¿Hay algo más después del ebook?</button>
        <div class="faq-a"><p>Sí. Al final del libro está la puerta al siguiente nivel: el Círculo Endonauta, un grupo pequeño de trabajo con acompañamiento. Se abre cuando hay cupo.</p></div>
      </div>
    </div>
  </section>

  <footer>
    <div class="wrap foot-grid">
      <a href="/" class="nv-logo">Endonautas</a>
      <div class="foot-links">
        <a href="/contacto/">Contacto</a>
        <a href="/privacidad/">Privacidad</a>
        <a href="/terminos/">Términos</a>
      </div>
      <p class="foot-copy">© {new Date().getFullYear()} Endonautas</p>
    </div>
  </footer>

  <script define:vars={{ HERIDAS: HERIDAS_MIN }}>
    (function () {
      const params = new URLSearchParams(location.search);
      const slug = params.get('herida');
      const h = HERIDAS.find((x) => x.id === slug) || HERIDAS.find((x) => x.id === 'abandono');
      if (h) {
        if (slug) {
          document.getElementById('hk').textContent = 'Tu resultado: ' + h.mascara;
          document.getElementById('h1').innerHTML =
            'Herida de ' + h.herida.toLowerCase() + '.<br/><em>Esto es lo que sigue.</em>';
          document.getElementById('hero-sub').innerHTML =
            'Tu test dio <strong>' + h.mascara.toLowerCase() + '</strong>. Soy Franco, terapeuta ' +
            'en salud integrativa, y escribí <em>Endonautica</em> como el mapa completo detrás de ' +
            'ese resultado — de dónde viene, cómo se sostiene, y cómo empezar a moverla.';
        }
        document.getElementById('m-title').textContent = 'La herida de ' + h.herida.toLowerCase() + ', en el libro';
        document.getElementById('m-text').textContent = h.intro;
      }

      // reveals
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('on'); obs.unobserve(e.target); } });
      }, { threshold: .12 });
      document.querySelectorAll('.reveal, .sec, .hero-copy, .hero-cover').forEach((el) => obs.observe(el));

      // faq
      document.querySelectorAll('.faq-item').forEach((item) => {
        item.querySelector('.faq-q').addEventListener('click', () => {
          const open = item.classList.contains('open');
          document.querySelectorAll('.faq-item').forEach((i) => i.classList.remove('open'));
          if (!open) item.classList.add('open');
        });
      });

      // medición — el script de Umami es defer, así que puede no estar todavía
      const track = (evento, props) => {
        if (window.umami) window.umami.track(evento, props);
      };
      const origen = slug || 'frio';

      document.getElementById('cta-hero')?.addEventListener('click', () => {
        track('ebook-cta-comprar', { origen });
      });
      // Último punto medible antes de irse a la pasarela: la diferencia entre este
      // número y las ventas reales es lo que se cae dentro de MercadoPago/PayPal.
      document.querySelectorAll('.buy-form').forEach((form) => {
        form.addEventListener('submit', () => {
          track('ebook-checkout-submit', {
            gateway: form.action.includes('paypal') ? 'paypal' : 'mp',
            origen,
          });
        });
      });
    })();
  </script>

  <style>
    :root {
      --bg:     #F0E8DC;
      --surf:   #FAF5EC;
      --ink:    #1A1410;
      --acc:    #C07820;
      --acc-d:  #9C6116;
      --mut:    #6B5D4F;
      --bdr:    #E4D8C3;
      --fd:     'EB Garamond', serif;
      --fs:     'Source Sans 3', sans-serif;
    }
    * , *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--bg); color: var(--ink); font-family: var(--fs);
      line-height: 1.5; -webkit-font-smoothing: antialiased;
    }
    .wrap { max-width: 1180px; margin: 0 auto; padding: 0 6vw; }
    .wrap-narrow { max-width: 780px; }
    em { font-style: italic; color: var(--acc-d); }

    nav {
      display: flex; align-items: center; justify-content: space-between;
      padding: 1.6rem 6vw;
    }
    .nv-logo { font-family: var(--fd); font-weight: 600; font-size: 1.15rem; color: var(--ink); text-decoration: none; letter-spacing: -.01em; }
    .nv-back { font-size: .85rem; color: var(--mut); text-decoration: none; }
    .nv-back:hover { color: var(--ink); }

    .btn {
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--fs); font-weight: 600; font-size: .96rem;
      padding: .95rem 2.1rem; border-radius: 8px; text-decoration: none;
      border: 1.5px solid transparent; cursor: pointer; transition: .18s;
    }
    .btn-p { background: var(--acc); color: #FAF3E6; }
    .btn-p:hover { background: var(--acc-d); }
    .btn-o { background: transparent; color: var(--ink); border-color: var(--ink); }
    .btn-o:hover { background: rgba(26,20,16,.05); }

    /* ── hero ── */
    .hero { padding: 5rem 0 6rem; overflow: hidden; position: relative; }
    .hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 5rem; align-items: center; }
    .hero-copy { opacity: 0; transform: translateY(14px); transition: opacity .6s ease, transform .6s ease; }
    .hero-copy.on { opacity: 1; transform: none; }
    .price-badge {
      display: inline-block; font-size: .78rem; font-weight: 600; letter-spacing: .03em;
      color: var(--acc-d); border: 1px solid var(--acc); background: rgba(192,120,32,.08);
      padding: .4rem .9rem; border-radius: 20px; margin-bottom: 1.3rem;
    }
    .kicker { font-family: var(--fs); font-weight: 600; font-size: .82rem; letter-spacing: .04em; color: var(--acc-d); margin-bottom: .6rem; }
    h1 {
      font-family: var(--fd); font-weight: 400; color: var(--ink);
      font-size: clamp(2.1rem, 4.4vw, 3.4rem); line-height: 1.15;
      letter-spacing: -.01em; margin-bottom: 1.4rem; text-wrap: balance;
    }
    .lead { font-size: 1.06rem; line-height: 1.7; color: var(--mut); max-width: 50ch; text-wrap: pretty; }
    .lead em, .lead strong { color: var(--ink); font-style: normal; font-weight: 600; }
    .hero-ctas { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2.3rem; }

    .hero-cover { position: relative; opacity: 0; transform: translateY(14px) scale(.98); transition: opacity .7s ease .1s, transform .7s ease .1s; }
    .hero-cover.on { opacity: 1; transform: none; }
    .hero-cover img {
      width: 100%; max-width: 340px; margin: 0 auto; display: block;
      border-radius: 6px; box-shadow: 0 30px 60px rgba(26,20,16,.22);
      position: relative; z-index: 1;
    }
    .blob { position: absolute; border-radius: 50%; filter: blur(50px); z-index: 0; }
    .blob-1 { width: 320px; height: 320px; background: rgba(192,120,32,.25); top: -60px; right: 10%; }
    .blob-2 { width: 260px; height: 260px; background: rgba(192,120,32,.15); bottom: -40px; left: 5%; }

    /* ── secciones ── */
    .sec { padding: 5.5rem 0; opacity: 0; transform: translateY(16px); transition: opacity .6s ease, transform .6s ease; }
    .sec.on { opacity: 1; transform: none; }
    .sec-alt { background: var(--surf); }
    .eyebrow { font-size: .8rem; font-weight: 600; color: var(--acc-d); letter-spacing: .03em; margin-bottom: .8rem; }
    .sec-h {
      font-family: var(--fd); font-weight: 400; color: var(--ink);
      font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.25; letter-spacing: -.01em;
      margin-bottom: 1.3rem; text-wrap: balance;
    }
    .body { font-size: 1.02rem; line-height: 1.78; color: var(--mut); max-width: 66ch; margin-bottom: 1.2rem; text-wrap: pretty; }
    .body em { font-style: normal; color: var(--ink); font-weight: 600; }

    /* ── índice del libro ── */
    .toc { list-style: none; display: grid; gap: 1.6rem; margin: 2.2rem 0 1.8rem; }
    .toc li { display: grid; grid-template-columns: auto 1fr; gap: 1.2rem; align-items: start; }
    .toc-n {
      font-family: var(--fd); font-size: 1.05rem; color: var(--acc);
      line-height: 1.3; padding-top: .1rem;
    }
    .toc-h { font-family: var(--fd); font-size: 1.15rem; color: var(--ink); margin-bottom: .3rem; }
    .toc-t { font-size: .94rem; line-height: 1.62; color: var(--mut); max-width: 58ch; text-wrap: pretty; }
    @media (max-width: 560px) { .toc li { gap: .9rem; } }

    /* ── testimonios ── */
    .tst-grid { display: grid; gap: 1.2rem; margin: 2.2rem 0 0; }
    @media (min-width: 760px) { .tst-grid { grid-template-columns: 1fr 1fr; } }
    .tst {
      padding: 1.6rem 1.7rem; background: var(--surf);
      border: 1px solid var(--bdr); border-left: 3px solid var(--acc); border-radius: 4px;
    }
    .tst-q {
      font-family: var(--fd); font-size: 1.02rem; line-height: 1.6;
      color: var(--ink); font-style: italic; margin-bottom: .9rem; text-wrap: pretty;
    }
    .tst-a { font-size: .84rem; color: var(--mut); }

    /* ── para quién es / para quién no ── */
    .fit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; margin: 2rem 0 1.8rem; }
    .fit-h {
      font-family: var(--fd); font-size: 1.15rem; color: var(--ink);
      padding-bottom: .7rem; margin-bottom: 1.1rem; border-bottom: 1px solid var(--bdr);
    }
    .fit-list { list-style: none; display: grid; gap: .9rem; }
    .fit-list li {
      position: relative; padding-left: 1.6rem;
      font-size: .98rem; line-height: 1.6; color: var(--mut); text-wrap: pretty;
    }
    .fit-list li::before {
      content: '✓'; position: absolute; left: 0; top: -.05rem;
      color: var(--acc); font-weight: 700;
    }
    .fit-list-no li::before { content: '✕'; color: #A8493C; font-weight: 600; }
    @media (max-width: 720px) { .fit-grid { grid-template-columns: 1fr; gap: 2.2rem; } }

    /* ── garantía ── */
    .warranty {
      margin-top: 2rem; padding: 1.6rem 1.8rem;
      border: 1px solid var(--bdr); border-left: 3px solid var(--acc);
      border-radius: 4px; background: var(--bg);
    }
    .warranty-h { font-family: var(--fd); font-size: 1.1rem; color: var(--ink); margin-bottom: .5rem; }
    .warranty-t { font-size: .97rem; line-height: 1.7; color: var(--mut); text-wrap: pretty; }
    .warranty-t em { font-style: normal; font-weight: 600; color: var(--ink); }

    /* ── muestra ── */
    .quote-card {
      background: var(--surf); border: 1px solid var(--bdr); border-radius: 12px;
      padding: 2.2rem 2rem; margin: 1.6rem 0 1.4rem; border-left: 3px solid var(--acc);
    }
    .m-text { font-family: var(--fd); font-style: italic; font-size: clamp(1.1rem, 2vw, 1.3rem); line-height: 1.6; color: var(--ink); }
    .m-foot { color: var(--mut); font-size: .9rem; line-height: 1.6; max-width: 56ch; }

    /* ── autor ── */
    .autor-grid { display: grid; grid-template-columns: 220px 1fr; gap: 3.5rem; align-items: center; }
    .autor-foto { width: 100%; border-radius: 12px; object-fit: cover; aspect-ratio: 1/1; box-shadow: 0 16px 40px rgba(26,20,16,.18); }

    /* ── compra ── */
    .buy-card {
      background: var(--surf); border: 1px solid var(--bdr); border-radius: 16px;
      padding: 3rem 2.6rem; text-align: center;
    }
    .buy-price { font-family: var(--fd); font-weight: 400; font-size: clamp(2.8rem, 6vw, 4rem); color: var(--ink); margin: 1rem 0 .3rem; }
    .buy-price span { font-size: 1.1rem; color: var(--mut); }
    .buy-clp { text-align: center; font-size: .85rem; color: var(--mut); margin-bottom: .5rem; }
    .buy-clp strong { color: var(--ink); font-weight: 600; }
    .buy-sub { color: var(--mut); font-size: .88rem; margin-bottom: 2.2rem; }
    .buy-forms { display: grid; gap: 1.4rem; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); text-align: left; }
    .buy-form { display: flex; flex-direction: column; gap: .55rem; }
    .buy-gw { font-size: .74rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--acc-d); }
    .buy-label { font-size: .78rem; color: var(--mut); }
    .buy-input {
      background: #fff; border: 1px solid var(--bdr); border-radius: 8px;
      color: var(--ink); font-family: var(--fs); font-size: .95rem; padding: .8rem 1rem;
      outline: none; transition: border-color .18s;
    }
    .buy-input:focus { border-color: var(--acc); }
    .buy-btn { width: 100%; }
    .buy-wa { margin-top: 2.2rem; color: var(--mut); font-size: .87rem; }
    .buy-wa a { color: var(--acc-d); text-decoration: underline; }

    /* ── FAQ ── */
    .faq-item { border-bottom: 1px solid var(--bdr); }
    .faq-q {
      width: 100%; text-align: left; background: none; border: none; cursor: pointer;
      padding: 1.3rem 0; font-family: var(--fs); font-size: 1rem; font-weight: 600; color: var(--ink);
      display: flex; justify-content: space-between; align-items: center;
    }
    .faq-q::after { content: '+'; color: var(--acc); font-size: 1.3rem; font-weight: 400; }
    .faq-item.open .faq-q::after { content: '−'; }
    .faq-a { max-height: 0; overflow: hidden; transition: max-height .3s ease; }
    .faq-item.open .faq-a { max-height: 200px; }
    .faq-a p { color: var(--mut); font-size: .95rem; line-height: 1.65; padding-bottom: 1.3rem; max-width: 62ch; }

    footer { padding: 3rem 0; border-top: 1px solid var(--bdr); }
    .foot-grid { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.2rem; }
    .foot-links { display: flex; gap: 1.4rem; }
    .foot-links a { font-size: .85rem; color: var(--mut); text-decoration: none; }
    .foot-links a:hover { color: var(--ink); }
    .foot-copy { font-size: .78rem; color: var(--mut); width: 100%; text-align: center; margin-top: .5rem; }

    @media (max-width: 860px) {
      .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      .hero-cover { order: -1; max-width: 260px; margin: 0 auto; }
      .autor-grid { grid-template-columns: 1fr; text-align: center; }
      .autor-foto { max-width: 180px; margin: 0 auto; }
      .buy-card { padding: 2.2rem 1.5rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-copy, .hero-cover, .sec { transition: none; opacity: 1; transform: none; }
    }
  </style>
</body>
</html>

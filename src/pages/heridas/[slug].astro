---
import Layout from '../../layouts/Layout.astro';
import { HERIDAS } from '../../data/heridas';

// Una página por herida para el long tail ("herida de abandono en la adultez",
// "…en la pareja", "cómo sanar…"). El hub /test-heridas-de-infancia/ captura la
// cabeza de la keyword; estas cinco capturan la cola, que es la mayor parte del
// tráfico. Contenido en src/data/heridas.ts — compartido con el hub.
export function getStaticPaths() {
  return HERIDAS.map((h) => ({ params: { slug: h.id }, props: { h } }));
}

const { h } = Astro.props;
const otras = HERIDAS.filter((x) => x.id !== h.id);

const nombre = h.herida.toLowerCase();
const title = `Herida de ${nombre}: señales en la adultez y cómo trabajarla | Endonautas`;
const description = `Herida de ${nombre} y ${h.mascara.toLowerCase()}: cómo se ve en la vida adulta y en la pareja, dónde se aloja en el cuerpo y por dónde empezar. Con test gratis de las 5 heridas de la infancia.`;
const botUrl = `https://t.me/Endonautas_bot1_bot?start=herida_${h.id}`;
const appUrl = `https://app.endonautas.cl/registro/?utm_source=heridas&utm_medium=web&utm_campaign=${h.id}`;
---

<Layout title={title} description={description} ogType="article">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'FAQPage',
          mainEntity: h.faq.map(([q, a]) => ({
            '@type': 'Question', name: q,
            acceptedAnswer: { '@type': 'Answer', text: a },
          })),
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Test de heridas de infancia', item: 'https://endonautas.cl/test-heridas-de-infancia/' },
            { '@type': 'ListItem', position: 2, name: `Herida de ${nombre}` },
          ],
        },
      ],
    })} />
  </Fragment>

  <!-- ── HERO ── -->
  <section class="s s-dark" id="inicio">
    <div class="container" style="max-width:860px">
      <div class="halo from-b on">
        <p class="mig">
          <a href="/test-heridas-de-infancia/">Las 5 heridas de la infancia</a>
          <span>/</span> Herida de {nombre}
        </p>
        <h1>Herida de {nombre}:<br/>{h.mascara.toLowerCase()}</h1>
        {h.intro.map((p) => <p class="lead">{p}</p>)}
        <div class="hero-ctas">
          <a class="btn btn-p" href="/test-heridas-de-infancia/#test">Hacer el test — 5 preguntas</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── DE DÓNDE VIENE ── -->
  <section class="s s-darker">
    <div class="container" style="max-width:860px">
      <div class="halo from-b">
        <h2 class="s-h">De dónde viene</h2>
        <p class="body">{h.origen}</p>
        <p class="body">
          Conviene decirlo antes de seguir: nada de esto es una acusación a quien te crió.
          Una herida de infancia no requiere maltrato ni intención. Requiere un niño
          sacando la única conclusión que podía sacar con la información que tenía.
        </p>
      </div>
    </div>
  </section>

  <!-- ── EN LA ADULTEZ ── -->
  <section class="s s-dark" id="adultez">
    <div class="container" style="max-width:860px">
      <div class="halo from-b">
        <h2 class="s-h">Cómo se ve la herida de {nombre} en la adultez</h2>
        <p class="s-sub">
          La herida no habla de la infancia: habla en presente, con la voz de tus decisiones de hoy.
        </p>
      </div>
      <ul class="lst">
        {h.adultez.map((t, i) => (
          <li class="from-b" data-d={String(i % 3)}>{t}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── EN LA PAREJA ── -->
  <section class="s s-darker" id="pareja">
    <div class="container" style="max-width:860px">
      <div class="halo from-b">
        <h2 class="s-h">La herida de {nombre} en las relaciones de pareja</h2>
        <p class="s-sub">
          El vínculo íntimo es donde la máscara trabaja más, porque es donde hay más que perder.
        </p>
      </div>
      <ul class="lst">
        {h.pareja.map((t, i) => (
          <li class="from-b" data-d={String(i % 3)}>{t}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── LA MÁSCARA ── -->
  <section class="s s-dark" id="mascara">
    <div class="container" style="max-width:860px">
      <div class="halo from-b">
        <h2 class="s-h">{h.mascara}</h2>
        <p class="body">{h.frase}</p>
        <p class="body">
          La máscara es la fachada que se construyó encima de la herida para que no volviera a
          doler. Tiene dos partes: una mental, hecha de patrones que se repiten, y una física,
          que el cuerpo sostiene aunque nadie la mire. Con los años la narrativa personal deja
          de distinguir entre la máscara y la persona.
        </p>
      </div>

      <div class="card b-card from-b">
        <p class="lbl" style="color:var(--am);margin-bottom:1rem">◎ La voz de adentro</p>
        <p class="b-int">
          Los bucles narrativos de autosabotaje son frases que se repiten desde la infancia
          y suenan a verdad porque llevan décadas sonando. En esta herida suelen decir:
        </p>
        {h.bucles.map((b) => <p class="b-q">{b}</p>)}
      </div>

      <div class="card c-card from-b" data-d="1">
        <p class="lbl" style="color:var(--c);margin-bottom:1rem">✦ En el cuerpo</p>
        <p class="body" style="margin:0">{h.corazaLarga}</p>
      </div>
    </div>
  </section>

  <!-- ── POR DÓNDE EMPEZAR ── -->
  <section class="s s-darker" id="sanar">
    <div class="container" style="max-width:860px">
      <div class="halo from-b">
        <h2 class="s-h">Cómo empezar a sanar la herida de {nombre}</h2>
        <p class="s-sub">
          El trabajo no es arrancarse la máscara: es dejar de confundirla con uno mismo.
          Cuatro movimientos concretos, del más pequeño al más incómodo.
        </p>
      </div>
      <div class="t-grid">
        {h.trabajo.map((t, i) => (
          <article class="card t-card from-b" data-d={String(i % 3)}>
            <span class="t-n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="t-t">{t.t}</h3>
            <p class="t-d">{t.d}</p>
          </article>
        ))}
      </div>
      <p class="t-foot">
        Si algo de esto te remueve más de lo esperado, eso no es una señal de que lo estés
        haciendo mal: es material para trabajar acompañado, no en soledad.
      </p>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="s s-dark">
    <div class="container" style="max-width:820px">
      <div class="card cta-card halo from-b on">
        <p class="lbl" style="color:var(--c)">✦ Gratis · sin registro</p>
        <h2 class="cta-h">¿Es esta tu herida, o llegaste acá buscando a otra persona?</h2>
        <p class="cta-s">
          Cinco preguntas y el resultado aparece en la misma pantalla. No pide correo y no
          guarda nada. Si ya sabes cuál es la tuya, sirve igual para ver qué máscara construiste.
        </p>
        <div class="cta-btns">
          <a class="btn btn-p btn-lg" href="/test-heridas-de-infancia/#test">Hacer el test</a>
          <a class="btn btn-o" href={appUrl}>Trabajar esto en la app</a>
        </div>
        <p class="cta-mini">
          También existe <a href={botUrl} target="_blank" rel="noopener">un acompañamiento diario
          por Telegram</a> para quien quiere volver a esto todos los días.
        </p>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="s s-darker" id="faq">
    <div class="container" style="max-width:820px">
      <div class="halo from-b">
        <h2 class="s-h">Preguntas frecuentes sobre la herida de {nombre}</h2>
      </div>
      {h.faq.map(([q, a]) => (
        <div class="faq-item from-b">
          <div class="faq-q">{q}</div>
          <div class="faq-a"><p>{a}</p></div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── LAS OTRAS CUATRO ── -->
  <section class="s s-dark" id="otras">
    <div class="container">
      <div class="halo from-b">
        <h2 class="s-h">Las otras cuatro heridas</h2>
        <p class="s-sub">
          Casi nadie tiene una sola. La que aparece primero suele ser la que está activa hoy,
          no la más antigua ni la única.
        </p>
      </div>
      <div class="o-grid">
        {otras.map((o, i) => (
          <a class="card o-card from-b" data-d={String(i % 3)} href={`/heridas/${o.id}/`}>
            <p class="lbl o-n">◎ Herida de {o.herida.toLowerCase()}</p>
            <h3 class="o-m">{o.mascara}</h3>
            <p class="o-f">{o.frase}</p>
            <span class="o-go">Leer sobre esta herida →</span>
          </a>
        ))}
      </div>
      <p class="o-pro">
        ¿Acompañas a otros en esto? Endonautas tiene un
        <a href="/profesionales/">plan para terapeutas y coaches</a> con este y otros
        instrumentos para el trabajo entre sesiones.
      </p>
    </div>
  </section>

  <style>
    /* ── hero ── */
    .mig { font-size: .78rem; color: var(--dim); margin-bottom: 1.2rem; letter-spacing: .02em; }
    .mig a { color: var(--c); text-decoration: none; }
    .mig a:hover { color: #fff; }
    .mig span { margin: 0 .45rem; color: var(--bdr); }

    h1 {
      font-family: var(--fd); font-weight: 300;
      font-size: clamp(1.85rem, 4.2vw, 3rem); line-height: 1.14;
      letter-spacing: -.03em; color: #fff; text-shadow: var(--ts);
      margin-bottom: 1.6rem; text-transform: none;
    }
    .lead {
      color: var(--txt); font-size: clamp(1rem, 1.5vw, 1.1rem);
      line-height: 1.7; max-width: 60ch; margin-bottom: 1.1rem;
    }
    .hero-ctas { margin-top: 2.2rem; }

    .body { color: var(--mut); font-size: .98rem; line-height: 1.75; max-width: 62ch; margin-bottom: 1.1rem; }

    /* ── listas de señales ── */
    .lst { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .1rem; }
    .lst li {
      color: var(--txt); font-size: .98rem; line-height: 1.65;
      padding: 1.15rem 0 1.15rem 1.9rem; border-bottom: 1px solid var(--bdr);
      position: relative; max-width: 66ch;
    }
    .lst li::before {
      content: '·'; position: absolute; left: .4rem; top: 1rem;
      color: var(--c); font-size: 1.5rem; line-height: 1;
    }
    .lst li:last-child { border-bottom: none; }

    /* ── bucles y cuerpo ── */
    .b-card { padding: 2rem 1.9rem; margin-top: 2.4rem; }
    .b-int { color: var(--mut); font-size: .92rem; line-height: 1.65; max-width: 58ch; margin-bottom: 1.4rem; }
    .b-q {
      font-family: var(--fd); font-weight: 300; color: #fff;
      font-size: clamp(1.02rem, 1.9vw, 1.22rem); line-height: 1.45;
      padding: .75rem 0 .75rem 1.2rem; border-left: 2px solid var(--am);
      margin-bottom: .7rem; letter-spacing: -.01em;
    }
    .b-q:last-child { margin-bottom: 0; }
    .c-card { padding: 2rem 1.9rem; margin-top: 1.1rem; }

    /* ── por dónde empezar ── */
    .t-grid { display: grid; gap: 1.1rem; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
    .t-card { padding: 1.9rem 1.7rem; }
    .t-n {
      font-family: var(--fd); font-size: .78rem; color: var(--c);
      letter-spacing: .16em; display: block; margin-bottom: .9rem;
    }
    .t-t {
      font-family: var(--fd); font-weight: 400; color: #fff;
      font-size: 1.1rem; letter-spacing: -.02em; line-height: 1.3; margin-bottom: .75rem;
    }
    .t-d { color: var(--mut); font-size: .9rem; line-height: 1.68; }
    .t-foot {
      text-align: center; color: var(--dim); font-size: .88rem;
      line-height: 1.6; margin: 2.8rem auto 0; max-width: 52ch;
    }

    /* ── CTA ── */
    .cta-card { padding: 3rem 2.6rem; text-align: center; }
    .cta-h {
      font-family: var(--fd); font-weight: 300; color: #fff;
      font-size: clamp(1.4rem, 2.9vw, 2rem); line-height: 1.22;
      letter-spacing: -.03em; margin: .9rem 0 1rem;
    }
    .cta-s { color: var(--mut); font-size: .96rem; line-height: 1.7; max-width: 52ch; margin: 0 auto; }
    .cta-btns { display: flex; flex-wrap: wrap; gap: .8rem; justify-content: center; margin-top: 2.1rem; }
    .cta-mini { margin-top: 1.5rem; color: var(--dim); font-size: .84rem; line-height: 1.6; }
    .cta-mini a { color: var(--c); text-decoration: none; border-bottom: 1px solid var(--cg); }
    .cta-mini a:hover { color: #fff; }

    /* ── FAQ (mismo comportamiento que el resto del sitio) ── */
    .faq-item { border-bottom: 1px solid var(--bdr); }
    .faq-q {
      cursor: pointer; padding: 1.35rem 0; color: var(--txt);
      font-size: .98rem; display: flex; justify-content: space-between; gap: 1.5rem;
      transition: color .18s;
    }
    .faq-q::after { content: '+'; color: var(--c); font-size: 1.2rem; line-height: 1; transition: transform .25s; }
    .faq-item.open .faq-q::after { transform: rotate(45deg); }
    .faq-q:hover { color: #fff; }
    .faq-a { max-height: 0; overflow: hidden; transition: max-height .32s cubic-bezier(.22,1,.36,1); }
    .faq-item.open .faq-a { max-height: 420px; }
    .faq-a p { color: var(--mut); font-size: .92rem; line-height: 1.65; padding-bottom: 1.35rem; max-width: 62ch; }

    /* ── otras heridas ── */
    .o-grid { display: grid; gap: 1.1rem; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
    .o-card {
      padding: 1.8rem 1.6rem; text-decoration: none; display: block;
      transition: border-color .3s, background .3s, transform .3s;
    }
    .o-card:hover {
      border-color: rgba(126,204,205,.4); background: rgba(126,204,205,.04);
      transform: translateY(-3px);
    }
    .o-n { color: var(--am); margin-bottom: .7rem; }
    .o-m {
      font-family: var(--fd); font-weight: 400; color: #fff;
      font-size: 1.08rem; letter-spacing: -.02em; margin-bottom: .7rem;
    }
    .o-f { color: var(--mut); font-size: .88rem; line-height: 1.6; margin-bottom: 1.1rem; }
    .o-go { color: var(--c); font-size: .82rem; }
    .o-pro {
      text-align: center; color: var(--dim); font-size: .87rem;
      line-height: 1.6; margin-top: 3rem;
    }
    .o-pro a { color: var(--vi); text-decoration: none; border-bottom: 1px solid rgba(155,142,196,.35); }
    .o-pro a:hover { color: #fff; }

    @media (max-width: 640px) {
      .cta-card { padding: 2.2rem 1.5rem; }
      .cta-btns .btn { width: 100%; }
      .b-card, .c-card, .t-card { padding: 1.6rem 1.4rem; }
    }
  </style>
</Layout>

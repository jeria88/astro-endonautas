---
import Layout from '../layouts/Layout.astro';
import { HERIDAS } from '../data/heridas';

// El contenido de las 5 heridas vive en src/data/heridas.ts, compartido con las páginas
// /heridas/<slug>/ y alineado con el bot de Telegram: una marca, un contenido. Al script
// del cliente van solo los 4 campos que usa el resultado — el resto del objeto es texto
// largo de las páginas propias y no tiene por qué viajar al navegador.
const HERIDAS_MIN = HERIDAS.map(({ id, herida, mascara, frase }) => ({ id, herida, mascara, frase }));

const PREGUNTAS = [
  { t: 'Cuando algo se rompe en un vínculo, ¿qué aparece primero en ti?', o: [
    ['El miedo a quedarme solo', 'abandono'],
    ['La certeza de que sobro', 'rechazo'],
    ['Vergüenza, como si fuera mi culpa', 'humillacion'],
    ['Rabia: alguien no cumplió', 'traicion'],
    ['Frialdad: esto no debió pasar así', 'injusticia'],
  ]},
  { t: 'Tu cuerpo guarda tensión. ¿Dónde la sientes?', o: [
    ['El pecho o la garganta que se cierran', 'abandono'],
    ['Los hombros encogidos hacia adentro', 'rechazo'],
    ['La espalda cargada, un peso encima', 'humillacion'],
    ['La mandíbula apretada', 'traicion'],
    ['Todo el cuerpo recto, rígido', 'injusticia'],
  ]},
  { t: 'En un día común, ¿qué te cuesta más?', o: [
    ['Estar sin plan y sin compañía', 'abandono'],
    ['Ocupar espacio, que me miren', 'rechazo'],
    ['Pedir algo para mí', 'humillacion'],
    ['Soltar el control', 'traicion'],
    ['Aceptar que algo quede imperfecto', 'injusticia'],
  ]},
  { t: 'Cuando te equivocas, la voz de adentro dice…', o: [
    ['«Así te van a dejar»', 'abandono'],
    ['«No deberías haber estado ahí»', 'rechazo'],
    ['«Qué vergüenza»', 'humillacion'],
    ['«No confíes en nadie»', 'traicion'],
    ['«Debiste hacerlo bien»', 'injusticia'],
  ]},
  { t: 'Lo que más deseas que alguien te diga:', o: [
    ['«No me voy a ir»', 'abandono'],
    ['«Tu lugar acá existe»', 'rechazo'],
    ['«No tienes que cargar esto solo»', 'humillacion'],
    ['«Puedes soltar, yo sostengo»', 'traicion'],
    ['«Está bien así, no hace falta más»', 'injusticia'],
  ]},
];

const FAQ = [
  ['¿Cuáles son las 5 heridas de la infancia?', 'Abandono, rechazo, humillación, traición e injusticia. Cada una genera una máscara — una forma de protegerse que se construyó cuando no había otra herramienta disponible: dependiente, huidiza, masoquista, controladora y rígida.'],
  ['¿Este test es gratis?', 'Sí, y no pide registro ni correo. Son cinco preguntas y el resultado aparece en la misma pantalla.'],
  ['¿Puedo tener más de una herida?', 'Casi siempre. El test te devuelve la que más pesa hoy, que no es necesariamente la más antigua ni la única. Lo que aparece primero suele ser lo que está activo en este momento de tu vida.'],
  ['¿Esto reemplaza a la terapia?', 'No. Es un punto de partida para observarte, no un diagnóstico. Si lo que aparece te remueve, eso es material para trabajar con alguien, no en soledad.'],
  ['¿Qué hago con el resultado?', 'La máscara no es el enemigo: te protegió cuando la necesitabas. El trabajo no es arrancarla, es dejar de confundirla contigo. Ahí empieza el viaje interior.'],
];

const title = 'Test de heridas de infancia — descubre tu máscara | Endonautas';
const description = 'Test gratis de las 5 heridas de la infancia: abandono, rechazo, humillación, traición e injusticia. Cinco preguntas, sin registro, y descubres qué máscara construiste.';
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: FAQ.map(([q, a]) => ({
        '@type': 'Question', name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    })} />
  </Fragment>

  <!-- ── HERO + TEST ── -->
  <section class="s s-full s-dark" id="test">
    <div class="container">
      <div class="halo from-b on" style="max-width:820px">
        <p class="lbl" style="color:var(--c);margin-bottom:1.1rem">✦ Test gratuito · sin registro</p>
        <h1>Test de heridas de infancia:<br/>¿cuál es tu máscara?</h1>
        <p class="hero-sub">
          Hay una máscara que construiste de niño para que no te hicieran daño otra vez.
          Hoy sigue puesta, y decide cosas por ti: a quién eliges, qué toleras, de qué te escondes.
          Cinco preguntas y te muestro cuál es.
        </p>
      </div>

      <!-- panel interactivo -->
      <div class="quiz card from-b" id="quiz" data-d="1">
        <!-- intro -->
        <div id="q-intro">
          <p class="q-lead">
            Responde con lo primero que aparezca, no con lo que te parezca más correcto.
            El test no guarda nada y no pide tu correo.
          </p>
          <button class="btn btn-p btn-lg" id="q-start" type="button">Ver mi espejo</button>
        </div>

        <!-- preguntas -->
        <div id="q-play" hidden>
          <div class="q-bar"><span id="q-fill"></span></div>
          <p class="q-count"><span id="q-n">1</span> de {PREGUNTAS.length}</p>
          <h2 class="q-title" id="q-title"></h2>
          {/* Los 5 botones se renderizan acá y el JS solo les cambia el texto. Crearlos en
              runtime no funciona: Astro scopea el CSS por elemento del template y un botón
              hecho con createElement no recibe ese scope — sale sin estilo. Todas las
              preguntas tienen 5 opciones, así que reusarlos es además menos código. */}
          <div class="q-opts" id="q-opts">
            {[0, 1, 2, 3, 4].map((i) => (
              <button type="button" class="q-opt" data-i={i}></button>
            ))}
          </div>
          <button class="q-back" id="q-back" type="button" hidden>← Volver a la anterior</button>
        </div>

        <!-- resultado -->
        <div id="q-res" hidden>
          <p class="lbl" style="color:var(--c)">Tu espejo</p>
          <h2 class="r-mask" id="r-mask"></h2>
          <p class="r-herida" id="r-herida"></p>
          <p class="r-frase" id="r-frase"></p>
          <p class="r-nota">
            La máscara no es el enemigo: te protegió cuando no tenías otra herramienta.
            El trabajo no es arrancarla, es dejar de confundirla contigo.
          </p>

          <form class="l-form" id="lead-form" method="POST" action="https://app.endonautas.cl/pago/ebook/lead/">
            <input type="hidden" name="canal_origen" value="test-heridas">
            <input type="hidden" name="herida" id="lead-herida" value="">
            <p class="l-lead">
              Esto es la punta del hilo. <em>Endonautica</em> tiene el mapa completo detrás de
              esta máscara — te mando gratis el PDF con tu herida en profundidad.
            </p>
            <div class="l-row">
              <input type="email" name="email" class="l-input" placeholder="tu@correo.com" required autocomplete="email">
              <button type="submit" class="btn btn-p">Enviarme el mapa completo</button>
            </div>
          </form>

          {/* Va DESPUÉS del form gratis a propósito: primero el PDF sin costo, y recién
              ahí la oferta. Al revés, el CTA pago compite con la captura del lead. */}
          <div class="r-libro">
            <p class="rl-t">
              Y si quieres el mapa entero: <em>Endonautica</em> son 205 páginas —
              esta herida y las otras cuatro, el marco completo del viaje interior.
            </p>
            <a class="btn btn-p rl-btn" id="r-libro" href="/">Ver el libro completo — $17</a>
          </div>

          <div class="r-ctas">
            <a class="btn btn-o" id="r-app" href="https://app.endonautas.cl/registro/?utm_source=test-heridas&utm_medium=web&utm_campaign=resultado">Trabajar esto en la app</a>
            <a class="btn btn-o" id="r-bot" href="https://t.me/Endonautas_bot1_bot?start=test_web" target="_blank" rel="noopener">Seguimiento diario en Telegram</a>
          </div>
          <p class="r-mas">
            <a id="r-mas" href="/heridas/abandono/">Leer sobre esta herida en profundidad →</a>
          </p>
          <div class="r-mini">
            <button type="button" id="r-share">Compartir mi resultado</button>
            <span>·</span>
            <button type="button" id="r-again">Hacerlo de nuevo</button>
          </div>
          <p class="r-pro" id="r-pro">
            ¿Acompañas a otros en esto? Endonautas tiene un
            <a href="/profesionales/">plan para terapeutas y coaches</a> con este y otros
            instrumentos para el trabajo entre sesiones.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── LAS 5 HERIDAS (contenido estático, indexable) ── -->
  <section class="s s-darker" id="heridas">
    <div class="container">
      <div class="halo from-b">
        <h2 class="s-h">Las cinco heridas de la infancia</h2>
        <p class="s-sub">
          Cada herida construye una máscara: una forma de protegerse que se armó cuando no había
          otra herramienta a mano. Reconocerla es el primer movimiento del viaje interior.
        </p>
      </div>

      <div class="h-grid">
        {HERIDAS.map((h, i) => (
          <article class="card h-card from-b" data-d={String(i % 3)} id={h.id}>
            <p class="lbl h-num">◎ Herida de {h.herida.toLowerCase()}</p>
            <h3 class="h-mask">{h.mascara}</h3>
            <p class="h-frase">{h.frase}</p>
            <p class="h-vida">{h.vida}</p>
            <p class="h-cuerpo"><span>En el cuerpo:</span> {h.cuerpo}</p>
            <a class="h-go" href={`/heridas/${h.id}/`}>
              Cómo se ve en la adultez y por dónde empezar →
            </a>
          </article>
        ))}
      </div>

      <p class="h-foot">
        ¿No sabes cuál es la tuya? <a href="#test">Haz el test</a> — son cinco preguntas.
      </p>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="s s-dark" id="faq">
    <div class="container" style="max-width:820px">
      <div class="halo from-b">
        <h2 class="s-h">Preguntas frecuentes</h2>
        <p class="s-sub">Sobre el test y sobre qué hacer con lo que aparezca.</p>
      </div>
      {FAQ.map(([q, a]) => (
        <div class="faq-item from-b">
          <div class="faq-q">{q}</div>
          <div class="faq-a"><p>{a}</p></div>
        </div>
      ))}
    </div>
  </section>

  <script define:vars={{ PREGUNTAS, HERIDAS: HERIDAS_MIN }}>
    const $ = (id) => document.getElementById(id);
    const orden = HERIDAS.map((h) => h.id);
    let paso = 0;
    const elegidas = [];

    const botones = Array.from(document.querySelectorAll('.q-opt'));
    botones.forEach((b) => b.addEventListener('click', () => {
      if (b.dataset.herida) responder(b.dataset.herida);
    }));

    function pintar() {
      const p = PREGUNTAS[paso];
      $('q-n').textContent = String(paso + 1);
      $('q-fill').style.width = ((paso / PREGUNTAS.length) * 100) + '%';
      $('q-title').textContent = p.t;
      botones.forEach((b, i) => {
        const op = p.o[i];
        b.textContent = op[0];
        b.dataset.herida = op[1];
      });
      $('q-back').hidden = paso === 0;
      $('q-play').classList.remove('fade');
      void $('q-play').offsetWidth;
      $('q-play').classList.add('fade');
    }

    function responder(id) {
      elegidas[paso] = id;
      paso += 1;
      if (paso < PREGUNTAS.length) pintar();
      else resultado();
    }

    function resultado() {
      const puntos = {};
      elegidas.forEach((id) => { puntos[id] = (puntos[id] || 0) + 1; });
      // Empate: gana la primera en el orden del marco — estable y sin azar,
      // igual que en el bot, para que la misma persona reciba el mismo espejo.
      let ganadora = orden[0];
      orden.forEach((id) => {
        if ((puntos[id] || 0) > (puntos[ganadora] || 0)) ganadora = id;
      });
      const h = HERIDAS.find((x) => x.id === ganadora);
      $('r-mask').textContent = h.mascara;
      $('r-herida').textContent = 'Herida de ' + h.herida.toLowerCase();
      $('r-frase').textContent = h.frase;
      $('r-bot').href = 'https://t.me/Endonautas_bot1_bot?start=test_web_' + h.id;
      $('r-mas').href = '/heridas/' + h.id + '/';
      $('r-libro').href = '/?herida=' + h.id;
      $('lead-herida').value = h.id;
      $('q-play').hidden = true;
      $('q-res').hidden = false;
      $('q-res').classList.add('fade');
      history.replaceState(null, '', '#resultado');

      // medición del embudo (Umami carga con defer: puede no estar todavía)
      const track = (ev, props) => { if (window.umami) window.umami.track(ev, props); };
      track('test-completado', { herida: h.id });
      $('lead-form').addEventListener('submit', () => {
        track('test-lead-submit', { herida: h.id });
      });
      $('r-libro').addEventListener('click', () => {
        track('test-cta-libro', { herida: h.id });
      });
      // el ancla del detalle largo de SU herida queda a un clic
      const ancla = document.getElementById(h.id);
      if (ancla) ancla.classList.add('h-hit');
    }

    $('q-start').addEventListener('click', () => {
      $('q-intro').hidden = true;
      $('q-play').hidden = false;
      pintar();
    });

    $('q-back').addEventListener('click', () => {
      if (paso > 0) { paso -= 1; pintar(); }
    });

    $('r-again').addEventListener('click', () => {
      paso = 0; elegidas.length = 0;
      document.querySelectorAll('.h-hit').forEach((e) => e.classList.remove('h-hit'));
      $('q-res').hidden = true;
      $('q-play').hidden = false;
      pintar();
    });

    $('r-share').addEventListener('click', async () => {
      const texto = $('r-mask').textContent + ' — ' + $('r-herida').textContent
        + '. ¿Cuál es tu máscara?';
      const url = location.origin + location.pathname;
      if (navigator.share) {
        try { await navigator.share({ title: 'Mi espejo', text: texto, url }); return; } catch (e) { /* cancelado */ }
      }
      try {
        await navigator.clipboard.writeText(texto + ' ' + url);
        $('r-share').textContent = 'Copiado ✓';
        setTimeout(() => { $('r-share').textContent = 'Compartir mi resultado'; }, 2200);
      } catch (e) { /* sin permiso de portapapeles */ }
    });
  </script>

  <style>
    /* el hero se centra en el alto disponible: en pantallas altas, con .s-full el
       contenido quedaba arriba y dejaba media pantalla vacía debajo de la card */
    #test { display: flex; align-items: center; }
    #test > .container { padding-top: 4vh; padding-bottom: 4vh; }

    h1 {
      font-family: var(--fd); font-weight: 300;
      font-size: clamp(1.9rem, 4.4vw, 3.2rem); line-height: 1.14;
      letter-spacing: -.03em; color: var(--text); text-shadow: var(--ts);
      margin-bottom: 1.3rem;
    }
    .hero-sub {
      color: var(--mut); font-size: clamp(.98rem, 1.5vw, 1.1rem);
      line-height: 1.65; max-width: 55ch;
    }

    /* ── panel del test ── */
    .quiz { margin-top: 3.2rem; max-width: 760px; padding: 2.6rem 2.4rem; }
    .q-lead { color: var(--mut); font-size: .95rem; line-height: 1.6; margin-bottom: 1.8rem; max-width: 52ch; }

    .q-bar { height: 2px; background: rgba(255,255,255,.07); border-radius: 2px; overflow: hidden; }
    .q-bar span {
      display: block; height: 100%; width: 0; background: var(--c);
      box-shadow: 0 0 12px var(--cg); transition: width .45s cubic-bezier(.22,1,.36,1);
    }
    .q-count { font-size: .7rem; color: var(--dim); letter-spacing: .12em; text-transform: uppercase; margin: 1.1rem 0 .5rem; }
    .q-title {
      font-family: var(--fd); font-weight: 300; color: var(--text);
      font-size: clamp(1.25rem, 2.4vw, 1.7rem); line-height: 1.3;
      letter-spacing: -.02em; margin-bottom: 1.8rem;
    }
    .q-opts { display: flex; flex-direction: column; gap: .6rem; }
    .q-opt {
      font-family: var(--fi); font-size: .95rem; color: var(--txt);
      text-align: left; padding: 1rem 1.2rem; cursor: pointer;
      background: rgba(255,255,255,.03); border: 1px solid var(--bdr);
      border-radius: 12px; transition: border-color .18s, background .18s, transform .18s;
    }
    .q-opt:hover {
      border-color: rgba(126,204,205,.45); background: rgba(126,204,205,.06);
      transform: translateX(4px);
    }
    .q-back {
      background: none; border: none; cursor: pointer; margin-top: 1.4rem;
      color: var(--dim); font-family: var(--fi); font-size: .82rem; padding: 0;
      transition: color .18s;
    }
    .q-back:hover { color: var(--text); }

    /* entrada rápida, salida lenta */
    .fade { animation: qin .42s cubic-bezier(.22,1,.36,1) both; }
    @keyframes qin { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

    /* ── resultado ── */
    .r-mask {
      font-family: var(--fd); font-weight: 300; color: var(--text);
      font-size: clamp(1.7rem, 3.4vw, 2.5rem); line-height: 1.15;
      letter-spacing: -.03em; margin: .7rem 0 .4rem;
    }
    .r-herida { color: var(--am); font-size: .95rem; margin-bottom: 1.4rem; }
    .r-frase { color: var(--txt); font-size: 1.05rem; line-height: 1.6; max-width: 52ch; }
    .r-nota {
      color: var(--mut); font-size: .92rem; line-height: 1.6; max-width: 52ch;
      margin-top: 1.1rem; padding-top: 1.1rem; border-top: 1px solid var(--bdr);
    }
    /* ── lead magnet: PDF de la herida ── */
    .l-form {
      margin-top: 1.8rem; padding: 1.6rem 1.7rem;
      background: rgba(126,204,205,.05); border: 1px solid rgba(126,204,205,.22);
      border-radius: 12px;
    }
    .l-lead { color: var(--txt); font-size: .92rem; line-height: 1.6; max-width: 54ch; margin-bottom: 1.1rem; }
    .l-lead em { color: var(--c); font-style: normal; }
    .l-row { display: flex; gap: .7rem; flex-wrap: wrap; }
    .l-input {
      flex: 1 1 220px;
      background: var(--surface); border: 1px solid var(--bdr);
      border-radius: 10px; color: var(--text); font-family: var(--fi);
      font-size: .95rem; padding: .85rem 1.1rem; outline: none;
      transition: border-color .18s;
    }
    .l-input::placeholder { color: var(--dim); }
    .l-input:focus { border-color: rgba(126,204,205,.5); }

    .r-libro {
      margin-top: 1.6rem; padding: 1.5rem 1.7rem;
      border: 1px solid var(--bdr); border-left: 2px solid var(--c);
      border-radius: 12px; background: var(--surface);
    }
    .rl-t { color: var(--mut); font-size: .92rem; line-height: 1.62; max-width: 54ch; margin-bottom: 1.1rem; }
    .rl-t em { color: var(--c); font-style: normal; }
    .rl-btn { display: inline-block; }

    .r-ctas { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
    .r-mas { margin-top: 1.4rem; font-size: .88rem; }
    .r-mas a { color: var(--c); text-decoration: none; border-bottom: 1px solid var(--cg); }
    .r-mas a:hover { color: var(--text); }
    .r-mini { display: flex; gap: .7rem; align-items: center; margin-top: 1.3rem; color: var(--bdr); font-size: .82rem; }
    .r-mini button {
      background: none; border: none; padding: 0; cursor: pointer;
      color: var(--dim); font-family: var(--fi); font-size: .82rem; transition: color .18s;
    }
    .r-mini button:hover { color: var(--c); }
    .r-pro {
      margin-top: 2rem; padding-top: 1.4rem; border-top: 1px solid var(--bdr);
      color: var(--dim); font-size: .85rem; line-height: 1.6;
    }
    .r-pro a { color: var(--vi); text-decoration: none; border-bottom: 1px solid rgba(155,142,196,.35); }
    .r-pro a:hover { color: var(--text); }

    /* ── grid de heridas ── */
    .h-grid {
      display: grid; gap: 1.1rem;
      grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    }
    /* columna + margin-top:auto en el link = todos los "→" alineados al pie
       aunque las tarjetas tengan textos de distinto largo */
    .h-card { padding: 1.9rem 1.7rem; transition: border-color .3s, background .3s; display: flex; flex-direction: column; }
    .h-card.h-hit { border-color: rgba(126,204,205,.45); background: rgba(126,204,205,.05); }
    .h-num { color: var(--am); margin-bottom: .8rem; }
    .h-mask {
      font-family: var(--fd); font-weight: 400; color: var(--text);
      font-size: 1.18rem; letter-spacing: -.02em; margin-bottom: .8rem;
    }
    .h-frase { color: var(--txt); font-size: .92rem; line-height: 1.6; margin-bottom: .9rem; }
    .h-vida { color: var(--mut); font-size: .88rem; line-height: 1.65; }
    .h-cuerpo { color: var(--dim); font-size: .82rem; margin-top: .9rem; margin-bottom: 1.2rem; }
    .h-cuerpo span { color: var(--c); }
    .h-go {
      display: inline-block; margin-top: auto; padding-top: 1rem;
      border-top: 1px solid var(--bdr); width: 100%;
      color: var(--c); font-size: .83rem; text-decoration: none; transition: color .18s;
    }
    .h-go:hover { color: var(--text); }
    .h-foot { text-align: center; color: var(--dim); font-size: .9rem; margin-top: 3rem; }
    .h-foot a { color: var(--c); text-decoration: none; border-bottom: 1px solid var(--cg); }

    /* ── FAQ (mismo comportamiento que el resto del sitio) ── */
    .faq-item { border-bottom: 1px solid var(--bdr); }
    .faq-q {
      cursor: pointer; padding: 1.35rem 0; color: var(--txt);
      font-size: .98rem; display: flex; justify-content: space-between; gap: 1.5rem;
      transition: color .18s;
    }
    .faq-q::after { content: '+'; color: var(--c); font-size: 1.2rem; line-height: 1; transition: transform .25s; }

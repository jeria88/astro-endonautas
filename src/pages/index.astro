---
// Página-elección — decisión de Franco (2026-08-27). La raíz dejó de ser la home del
// SaaS (que pasó a /software) y ahora bifurca los dos productos: el libro ($17, tráfico
// frío de contenido y test de heridas) y la plataforma ($39.990/mes, terapeutas).
// Standalone a propósito: sin <Layout>, sin cosmos Three.js, sin Nav — una elección con
// dos salidas no necesita menú, y el cosmos costaba ~medio megabyte antes del primer clic.
const title = 'Endonautas — el libro Endonautica y la plataforma para terapeutas';
const description =
  'Dos puertas al mismo mapa: Endonautica, el libro del viaje interior ($17 USD, PDF y EPUB), ' +
  'y Endonautas, el software para terapeutas y coaches con agenda, fichas clínicas y 35 tests. ' +
  'Franco Jeria Castro, terapeuta en salud integrativa.';
const canonical = 'https://endonautas.cl/';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://endonautas.cl/assets/img/epic-ebook.png" />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Endonautas" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" href="/assets/endonautas-logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
  <script type="application/ld+json" is:inline>{JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://endonautas.cl/#org",
        "name": "Endonautas",
        "url": "https://endonautas.cl",
        "logo": "https://endonautas.cl/assets/endonautas-logo.png",
        "founder": { "@type": "Person", "name": "Franco Jeria Castro" }
      },
      {
        "@type": "WebSite",
        "@id": "https://endonautas.cl/#website",
        "url": "https://endonautas.cl",
        "name": "Endonautas",
        "publisher": { "@id": "https://endonautas.cl/#org" }
      }
    ]
  })}</script>
  <script defer data-website-id="e03fa69e-9931-411c-9838-7f6ffea90426" src="https://analytics.146.181.39.4.sslip.io/script.js" is:inline></script>
</head>
<body>
  <div class="aura aura-a"></div>
  <div class="aura aura-b"></div>

  <main>
    <header class="top">
      <img src="/assets/endonautas-logo.png" alt="" width="34" height="34">
      <span class="brand">Endonautas</span>
    </header>

    <p class="intro">
      El mismo mapa, dos formas de entrar.
    </p>

    <div class="doors">
      <a class="door door-book" href="/ebook/">
        <span class="d-kick">El libro</span>
        <h2 class="d-title">Endonautica</h2>
        <p class="d-sub">
          El mapa del viaje interior: la herida de infancia, la sombra, los
          arquetipos y los niveles de conciencia. 205 páginas, tuyas para siempre.
        </p>
        <span class="d-price">$17 USD <em>· PDF y EPUB, entrega inmediata</em></span>
        <span class="d-cta">Ver el libro <span class="arw">→</span></span>
      </a>

      <a class="door door-app" href="/software/">
        <span class="d-kick">La plataforma</span>
        <h2 class="d-title">Para tu consulta</h2>
        <p class="d-sub">
          Agenda, fichas clínicas, notas de sesión y 35 tests validados que
          asignas y llegan corregidos. Tus clientes trabajan entre sesiones.
        </p>
        <span class="d-price">$39.990 al mes <em>· sin cobro por cliente</em></span>
        <span class="d-cta">Ver la plataforma <span class="arw">→</span></span>
      </a>
    </div>

    <footer class="bot">
      <p class="who">Franco Jeria Castro · terapeuta en salud integrativa</p>
      <nav class="links">
        <a href="/test-heridas-de-infancia/">Test de heridas de infancia</a>
        <a href="/profesionales/">Para terapeutas</a>
        <a href="/blog/">Blog</a>
        <a href="/contacto/">Contacto</a>
      </nav>
    </footer>
  </main>

  <script is:inline>
    // Qué puerta elige la gente: decide dónde apuntar el contenido y el bio-link.
    // Umami carga con defer, así que puede no estar cuando se hace el clic.
    document.querySelectorAll('.door').forEach(function (a) {
      a.addEventListener('click', function () {
        if (window.umami) {
          window.umami.track('raiz-puerta', {
            destino: a.classList.contains('door-book') ? 'libro' : 'plataforma',
          });
        }
      });
    });
  </script>

  <style>
    :root {
      --bg:   #030306;
      --txt:  #F2F0F4;
      --mut:  rgba(242,240,244,.62);
      --dim:  rgba(242,240,244,.34);
      --c:    #7ECCCD;
      --gold: #C79A4E;
      --fd:   'Space Grotesk', sans-serif;
      --fi:   'Inter', sans-serif;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--bg); color: var(--txt); font-family: var(--fi);
      min-height: 100dvh; overflow-x: hidden; -webkit-font-smoothing: antialiased;
    }

    /* Dos auras que respiran con frecuencias distintas por eje: el fondo nunca
       repite la misma posición, y no depende del scroll (esta página no scrollea). */
    .aura { position: fixed; border-radius: 50%; filter: blur(110px); pointer-events: none; z-index: 0; }
    .aura-a {
      width: 46vmax; height: 46vmax; background: rgba(126,204,205,.10);
      top: -12vmax; right: -8vmax; animation: driftA 31s ease-in-out infinite;
    }
    .aura-b {
      width: 40vmax; height: 40vmax; background: rgba(199,154,78,.09);
      bottom: -14vmax; left: -10vmax; animation: driftB 37s ease-in-out infinite;
    }
    @keyframes driftA {
      0%,100% { transform: translate(0,0) scale(1); }
      33%     { transform: translate(-3.5vmax, 2.4vmax) scale(1.06); }
      66%     { transform: translate(2.2vmax, -3.1vmax) scale(.97); }
    }
    @keyframes driftB {
      0%,100% { transform: translate(0,0) scale(1); }
      40%     { transform: translate(3.1vmax, -2.6vmax) scale(1.05); }
      75%     { transform: translate(-2.4vmax, 1.8vmax) scale(.98); }
    }
    @media (prefers-reduced-motion: reduce) { .aura { animation: none; } }

    main {
      position: relative; z-index: 1;
      min-height: 100dvh; display: flex; flex-direction: column;
      justify-content: center; gap: 3rem;
      max-width: 1120px; margin: 0 auto; padding: 4rem 6vw;
    }

    .top { display: flex; align-items: center; gap: .7rem; }
    .top img { object-fit: contain; opacity: .9; }
    .brand {
      font-family: var(--fd); font-weight: 500; font-size: 1.05rem;
      letter-spacing: .01em;
    }

    .intro {
      font-family: var(--fd); font-weight: 300;
      font-size: clamp(1.5rem, 3.4vw, 2.4rem); line-height: 1.2;
      letter-spacing: -.02em; color: var(--txt); max-width: 18ch;
      animation: rise .7s cubic-bezier(.2,.7,.3,1) both;
    }

    .doors { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; }

    .door {
      position: relative; display: flex; flex-direction: column;
      padding: 2.6rem 2.3rem 2.2rem;
      border: 1px solid rgba(255,255,255,.09); border-radius: 18px;
      background: rgba(255,255,255,.022);
      text-decoration: none; color: inherit; overflow: hidden;
      transition: border-color .35s ease, background .35s ease, transform .35s cubic-bezier(.2,.7,.3,1);
      animation: rise .8s cubic-bezier(.2,.7,.3,1) both;
    }
    .door-book { animation-delay: .09s; }
    .door-app  { animation-delay: .17s; }

    /* El halo de cada puerta la tiñe con su propio mundo: oro el libro, calipso
       la plataforma — la misma señal de color que usa cada landing de destino. */
    .door::before {
      content: ''; position: absolute; inset: -1px; border-radius: 18px;
      opacity: 0; transition: opacity .35s ease; pointer-events: none;
    }
    .door-book::before { background: radial-gradient(120% 80% at 50% 0%, rgba(199,154,78,.13), transparent 62%); }
    .door-app::before  { background: radial-gradient(120% 80% at 50% 0%, rgba(126,204,205,.13), transparent 62%); }
    .door:hover, .door:focus-visible { transform: translateY(-4px); background: rgba(255,255,255,.04); outline: none; }
    .door:hover::before, .door:focus-visible::before { opacity: 1; }
    .door-book:hover, .door-book:focus-visible { border-color: rgba(199,154,78,.42); }
    .door-app:hover,  .door-app:focus-visible  { border-color: rgba(126,204,205,.42); }

    .d-kick { font-size: .74rem; letter-spacing: .13em; text-transform: uppercase; margin-bottom: 1.4rem; }
    .door-book .d-kick { color: var(--gold); }
    .door-app  .d-kick { color: var(--c); }

    .d-title {
      font-family: var(--fd); font-weight: 400;
      font-size: clamp(1.6rem, 2.8vw, 2.1rem); line-height: 1.15;
      letter-spacing: -.025em; margin-bottom: 1rem;
    }
    .d-sub {
      color: var(--mut); font-size: .96rem; line-height: 1.66;
      max-width: 34ch; margin-bottom: 1.9rem; text-wrap: pretty;
    }
    .d-price {
      font-family: var(--fd); font-size: 1rem; margin-top: auto;
      padding-top: 1.4rem; border-top: 1px solid rgba(255,255,255,.07);
    }
    .d-price em { font-family: var(--fi); font-style: normal; font-size: .82rem; color: var(--dim); }

    .d-cta { margin-top: 1.1rem; font-size: .92rem; font-weight: 500; display: inline-flex; gap: .5rem; }
    .door-book .d-cta { color: var(--gold); }
    .door-app  .d-cta { color: var(--c); }
    .arw { transition: transform .3s cubic-bezier(.2,.7,.3,1); }
    .door:hover .arw { transform: translateX(5px); }

    .bot {
      display: flex; flex-wrap: wrap; align-items: center;
      justify-content: space-between; gap: 1rem 2rem;
      animation: rise .8s cubic-bezier(.2,.7,.3,1) .26s both;
    }
    .who { color: var(--dim); font-size: .82rem; }
    .links { display: flex; flex-wrap: wrap; gap: 1.4rem; }
    .links a {
      color: var(--dim); font-size: .82rem; text-decoration: none;
      transition: color .2s;
    }
    .links a:hover { color: var(--txt); }

    @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

    @media (max-width: 820px) {
      main { justify-content: flex-start; gap: 2.4rem; padding: 3rem 7vw 4rem; }
      .doors { grid-template-columns: 1fr; gap: 1.1rem; }
      .door { padding: 2.1rem 1.8rem 1.9rem; }
      .d-sub { margin-bottom: 1.5rem; }
      .bot { flex-direction: column; align-items: flex-start; }
    }
  </style>
</body>
</html>

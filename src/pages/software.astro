        <p class="nl-note">Sin spam · Sin llamadas · 1 email con el recorrido completo</p>
      </form>
    </div>
  </div>
</section>

<script is:inline>
(function(){
  var form = document.getElementById('nlForm');
  var btn  = document.getElementById('nlBtn');
  var msg  = document.getElementById('nlMsg');
  if (!form) return;

  form.addEventListener('submit', async function(e){
    e.preventDefault();
    var email = document.getElementById('nlEmail').value.trim();
    if (!email || !email.includes('@')) {
      msg.textContent = 'Ingresa un email válido.';
      msg.className = 'nl-msg err';
      return;
    }
    btn.disabled = true;
    btn.textContent = 'Enviando…';
    msg.textContent = '';
    msg.className = 'nl-msg';
    try {
      var res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email })
      });
      if (res.ok) {
        form.innerHTML = '<p class="nl-success">✦ Listo. Revisa tu email — te contamos cómo empezar.</p>';
      } else {
        throw new Error('error');
      }
    } catch {
      btn.disabled = false;
      btn.textContent = 'Mostrarme el portal';
      msg.textContent = 'Hubo un error. Intenta de nuevo.';
      msg.className = 'nl-msg err';
    }
  });
})();
</script>

<div id="lb">
  <span id="lb-close">✕</span>
  <button class="lb-nav" id="lb-prev">‹</button>
  <img id="lb-img" src="" alt="">
  <button class="lb-nav" id="lb-next">›</button>
  <div id="lb-dots"></div>
</div>

<script>
(function () {
  // Variables compartidas entre carrusel y lightbox
  let paused = false;
  let raf = 0;
  let targetFrac = 0;
  let currentFrac = 0;
  let N = 0;

  const scene  = document.getElementById('galleryScene');
  const track  = document.getElementById('galleryTrack');
  const lb     = document.getElementById('lb');
  const lbImg  = document.getElementById('lb-img');
  const lbClose = document.getElementById('lb-close');
  const lbPrev = document.getElementById('lb-prev');
  const lbNext = document.getElementById('lb-next');
  const lbDots = document.getElementById('lb-dots');

  const allCards = [...document.querySelectorAll('.gc')];
  N = allCards.length;

  // ── CARRUSEL DESKTOP ──
  const isDesktop = scene && track && !window.matchMedia('(max-width: 768px)').matches;

  if (isDesktop) {
    const GAP = 18;
    targetFrac  = (N - 1) / 2;
    currentFrac = targetFrac;

    const cw   = () => allCards[0]?.offsetWidth || 320;
    const step = () => cw() + GAP;
    const offsetForFrac = f => scene.offsetWidth / 2 - f * step() - cw() / 2;

    function applyFrame(offset) {
      track.style.transform = `translateX(${offset}px)`;
      const sc2 = scene.offsetWidth / 2;
      allCards.forEach((card, i) => {
        const center = offset + i * step() + cw() / 2;
        const d  = (center - sc2) / (scene.offsetWidth * 0.5);
        const ry = -d * 30;
        const tz = -Math.abs(d) * 110;
        const sc = Math.max(0.78, 1 - Math.abs(d) * 0.13);
        const op = Math.max(0.28, 1 - Math.abs(d) * 0.58);
        card.style.transform = `perspective(1400px) rotateY(${ry}deg) translateZ(${tz}px) scale(${sc})`;
        card.style.opacity   = op;
        card.style.zIndex    = Math.round(20 - Math.abs(d) * 10);
        const lbl = card.querySelector('.gc-label');
        if (lbl) lbl.style.opacity = Math.max(0, 1 - Math.abs(d) * 4);
      });
    }

    function tick() {
      currentFrac += (targetFrac - currentFrac) * 0.085;
      applyFrame(offsetForFrac(currentFrac));
      raf = Math.abs(targetFrac - currentFrac) > 0.0008 ? requestAnimationFrame(tick) : 0;
    }

    applyFrame(offsetForFrac(currentFrac));

    scene.addEventListener('mousemove', (e) => {
      if (paused) return;
      const r = scene.getBoundingClientRect();
      const x = Math.max(0, Math.min(1, (e.clientX - r.left) / r.width));
      targetFrac = x * (N - 1);
      if (!raf) raf = requestAnimationFrame(tick);
    });

    allCards.forEach((card, i) => {
      card.addEventListener('click', () => {
        paused = true;
        targetFrac = i;
        if (!raf) raf = requestAnimationFrame(tick);
        lbOpen(i);
      });
    });
  }

  // ── LIGHTBOX (desktop + mobile) ──
  if (!lb || !lbImg) return;

  const allImgs = allCards.map(c => c.querySelector('img'));
  let lbIdx = 0;

  // Dots indicadores
  allImgs.forEach((_, i) => {
    const d = document.createElement('div');
    d.className = 'lb-dot' + (i === 0 ? ' active' : '');
    lbDots?.appendChild(d);
  });

  function updateDots(i) {
    lbDots?.querySelectorAll('.lb-dot').forEach((d, j) => d.classList.toggle('active', j === i));
  }

  function lbOpen(i) {
    lbIdx = ((i % N) + N) % N;
    lbImg.style.opacity = '1';
    lbImg.src = allImgs[lbIdx].src;
    lbImg.alt = allImgs[lbIdx].alt;
    lb.classList.add('open');
    updateDots(lbIdx);
  }

  function lbNav(dir) {
    lbIdx = (lbIdx + dir + N) % N;
    lbImg.style.opacity = '0';
    setTimeout(() => {
      lbImg.src = allImgs[lbIdx].src;
      lbImg.alt = allImgs[lbIdx].alt;
      lbImg.style.opacity = '1';
      updateDots(lbIdx);
    }, 160);
  }

  function lbClose2() {
    lb.classList.remove('open');
    paused = false;
    if (!raf) raf = requestAnimationFrame(function tick2() {
      // retomar carrusel solo si hay cambio pendiente
      raf = 0;
    });
  }

  lb.addEventListener('click', (e) => { if (e.target === lb) lbClose2(); });
  lbClose?.addEventListener('click', lbClose2);
  lbPrev?.addEventListener('click', (e) => { e.stopPropagation(); lbNav(-1); });
  lbNext?.addEventListener('click', (e) => { e.stopPropagation(); lbNav(1); });

  document.addEventListener('keydown', (e) => {
    if (!lb.classList.contains('open')) return;
    if (e.key === 'Escape')     lbClose2();
    if (e.key === 'ArrowLeft')  { e.preventDefault(); lbNav(-1); }
    if (e.key === 'ArrowRight') { e.preventDefault(); lbNav(1); }
  });

  // Mobile: click directo
  if (!isDesktop) {
    allCards.forEach((card, i) => card.addEventListener('click', () => lbOpen(i)));
  }
})();
</script>
</Layout>
